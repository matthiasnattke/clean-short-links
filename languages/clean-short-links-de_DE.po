msgstr "Wie gewohnt weiterleiten"

#: includes/admin.php:1406
msgid "Short links work; pages of this site show the maintenance page."
msgstr "Kurzlinks funktionieren; Seiten dieser Website zeigen die Wartungsseite."

#: includes/admin.php:1407
msgid "Let targets through"
msgstr "Ziele durchlassen"

#: includes/admin.php:1407
msgid "Pages that active short links lead to stay reachable."
msgstr "Seiten, zu denen aktive Kurzlinks führen, bleiben erreichbar."

#: includes/admin.php:1408
msgid "Pause short links"
msgstr "Kurzlinks pausieren"

